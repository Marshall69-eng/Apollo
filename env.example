# ---------------------------------------------------------------- mode
# true  = DEMO: simulated sensors, every notification is a dry run, DEMO DATA banner shown
# false = LIVE: real channels. Requires SECRET_KEY and ADMIN_PASSWORD below.
SIMULATION_MODE=true

# ---------------------------------------------------------------- security (required when SIMULATION_MODE=false)
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_USERNAME=admin
# Creates the FIRST admin only (min 10 chars). Change it from the dashboard afterwards.
ADMIN_PASSWORD=
TOKEN_TTL_HOURS=12
# Only needed if the page is served from a different origin than the API (comma separated).
# Use "null" for a page opened from file:// while developing.
CORS_ORIGINS=

# ---------------------------------------------------------------- storage
# DB_PATH=/data/storm_baler.db
# RIVER_GEOJSON=/geo/calumpang_rivers.geojson
# READINGS_RETENTION_DAYS=90
# A deployed buoy silent for this long is declared OFFLINE (seconds). Match your reporting interval x ~3.
# STALE_AFTER_SECONDS=900

# ---------------------------------------------------------------- notification channels (all optional)
# Telegram: create a bot with @BotFather, add it to the DRRMO group, then add the group's chat id
# as a RECIPIENT in the Alerts tab (the old TELEGRAM_CHAT_ID variable is no longer used).
TELEGRAM_BOT_TOKEN=
# SMS via Vonage
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM_NUMBER=
# Bridge into an existing LGU incident system. Set here only, never from the UI.
GENERIC_WEBHOOK_URL=
# If set, webhook bodies are signed: header X-NetZero-Signature: sha256=<hmac of the raw body>
WEBHOOK_SECRET=

# ---------------------------------------------------------------- domain for docker-compose + Caddy (HTTPS)
DOMAIN=localhost
